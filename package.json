{
    "name": "nazuna-bot",
    "version": "9.0.0",
    "description": "Nazuna Bot - Bot de WhatsApp multifuncional executavel via npx nazuna-bot",
    "type": "module",
    "main": "dados/src/connect.js",
    "bin": {
        "nazuna-bot": "bin/nazuna.js",
        "nazuna": "bin/nazuna.js"
    },
    "files": [
        "bin/",
        "dados/src/",
        "dados/midias/",
        "!dados/src/**/*.bak.js",
        "!dados/src/**/*.backup*.js",
        "README.md"
    ],
    "scripts": {
        "start": "node dados/src/.scripts/start.js",
        "dev": "nodemon dados/src/.scripts/start.js",
        "config": "node dados/src/.scripts/config.js",
        "config:install": "node dados/src/.scripts/config.js --install",
        "update": "node dados/src/.scripts/update.js",
        "publish:all": "node scripts/publish.js"
    },
    "keywords": [
        "whatsapp",
        "whatsapp-bot",
        "baileys",
        "nazuna",
        "nazuna-bot",
        "npx",
        "multi-device"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gumballxnz/nazuna-bot.git"
    },
    "author": "Gumball",
    "license": "ISC",
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@whiskeysockets/baileys": "^7.0.0-rc.9",
        "axios": "^1.13.2",
        "fg-senna": "^0.0.9",
        "fluent-ffmpeg": "^2.1.3",
        "instagram-url-direct": "^2.0.7",
        "linkedom": "^0.18.12",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "node-webpmux": "^3.2.1",
        "pino": "^10.1.0",
        "qrcode-terminal": "^0.12.0",
        "yt-search": "^2.13.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.4"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=9.0.0"
    }
}
